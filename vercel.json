{
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{public,data}/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ],
  "crons": [
    { "path": "/api/cron/refresh-topics", "schedule": "0 7 * * 1-5" },
    { "path": "/api/cron/refresh-topics?profile=digital", "schedule": "0 9 * * 2,4" }
  ]
}
