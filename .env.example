# ---------------------------------------------------------------------------
# Melsoft Blog Agent — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Access control: both pages (generator + dashboard) require a Supabase login,
# and the billed /api routes verify that Supabase session server-side. There is
# no separate app password to configure.
# ---------------------------------------------------------------------------

# REQUIRED — Anthropic API key used by research + post generation.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# REQUIRED — Supabase project URL (e.g. https://xxxx.supabase.co).
SUPABASE_URL=your_supabase_project_url_here

# REQUIRED — Supabase SERVICE ROLE key (server-side only; never expose to the
# browser). Used by src/supabaseClient.js for reads/writes and for validating
# the caller's Supabase session token on /api requests.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OPTIONAL — secret that authenticates the scheduled cron (/api/cron/refresh-topics).
# Vercel injects it as "Authorization: Bearer <CRON_SECRET>" on cron runs.
CRON_SECRET=choose_a_random_string

# OPTIONAL — Discord webhook URL. When set, the Tue/Fri cron posts a notification
# here after it generates fresh topics. Leave unset to disable notifications.
DISCORD_WEBHOOK_URL=

# OPTIONAL — public app URL used in the Discord notification link and in the
# "review this draft" dashboard link sent back by the /generate command.
# Defaults to https://melsoft-blog.vercel.app when unset.
APP_URL=

# ---------------------------------------------------------------------------
# Discord Interactions (slash commands + buttons). These power the
# POST /api/discord/interactions endpoint and the one-time command-registration
# script (scripts/registerDiscordCommands.js). All of the values below are
# already configured locally and in Vercel — listed here only for documentation.
# ---------------------------------------------------------------------------

# Discord application (client) ID — used to register commands and to build the
# interaction followup webhook URL.
DISCORD_APPLICATION_ID=

# Discord application PUBLIC KEY — used to verify the Ed25519 signature on every
# incoming interaction request. Required for the interactions endpoint to work.
DISCORD_PUBLIC_KEY=

# Discord BOT TOKEN — used by scripts/registerDiscordCommands.js to register the
# slash commands, and by the cron notification when it posts a message with
# interactive "Generate" buttons (bot-sent messages render components natively).
# Never sent by the request-time interactions handler.
DISCORD_BOT_TOKEN=

# OPTIONAL — numeric ID of the channel where the Tue/Fri cron posts its topic
# notification. When this AND DISCORD_BOT_TOKEN are set, the notification is
# sent via the bot token so the "Generate #N" buttons render (a plain webhook
# can't render interactive buttons). If either is unset, the notification falls
# back to the plain-text DISCORD_WEBHOOK_URL path below.
# To get it: enable Developer Mode in Discord (Settings -> Advanced), then
# right-click the target channel -> Copy Channel ID.
DISCORD_CHANNEL_ID=

# OPTIONAL — comma-separated Discord user IDs to @mention on UNATTENDED
# notifications (the scheduled daily run, and failure alerts if enabled), so
# they raise a real Discord notification instead of a message that is easy to
# miss. Leave unset for the original no-mention behaviour.
# Replies to a button you just clicked are never mentioned — you are already
# looking at them.
# To get an ID: Discord Settings -> Advanced -> Developer Mode, then right-click
# a name -> Copy User ID.
DISCORD_MENTION_USER_IDS=

# OPTIONAL — comma-separated list of Discord user IDs allowed to run the
# money-spending / state-changing commands (/generate, /publish) and their
# button equivalents. Read-only /topics is not gated. Example:
#   DISCORD_ALLOWED_USER_IDS=123456789012345678,987654321098765432
# If unset/empty, generate & publish are denied for everyone (fail closed).
DISCORD_ALLOWED_USER_IDS=1118493982012481606, 1119698326598713365, 1332308831816126549

# ---------------------------------------------------------------------------
# Featured image generation (src/imageGen.js). The generated hero is uploaded to
# the SAME public `blog-images` Supabase bucket the dashboard uploader uses, and
# its permanent URL is stored in posts.image — so Discord, the dashboard and the
# live site all read one identical URL.
# ---------------------------------------------------------------------------

# Which generator to use: cloudflare | gemini | fal | openai | stub. Defaults
# to cloudflare. Only this line changes to switch providers.
#   cloudflare — Workers AI FLUX.2 [dev]. Free daily allocation, slow (~100s).
#                Used during development so nothing is billed.
#   gemini     — Nano Banana; matches the images already published on the blog.
#                Image generation has NO free tier (quota is a hard 0) — billing
#                must be enabled on the Google Cloud project behind the key.
#   fal        — fal.ai FLUX.2 [pro].
#   openai     — OpenAI GPT Image (gpt-image-2 by default). DALL-E 2/3 were
#                retired from the API on 2026-05-12 — this targets the GPT
#                Image family that replaced them. Requires the OpenAI
#                ORGANIZATION (not just the key) to complete "API Organization
#                Verification" in the OpenAI dashboard first, or every request
#                403s. No free tier — billing must be enabled.
#   stub       — Offline placeholder. No network, no cost; used by the tests.
IMAGE_PROVIDER=cloudflare

# Art direction: photoreal (default — matches the existing published posts) or
# illustration (abstract brand art, no people).
IMAGE_STYLE=photoreal

# Output size. Production targets 16:9 (1024x576) to match the most recent
# published heroes. Development can use 1024x512, which costs half the Cloudflare
# neurons per image (billing is per 512x512 tile per step).
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576

# Cloudflare Workers AI — required when IMAGE_PROVIDER=cloudflare.
# Account ID: Workers AI page, or the hex string in the dashboard URL.
# Token: needs BOTH "Workers AI Read" AND "Workers AI Edit" permissions.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# CF_IMAGE_STEPS=20

# Google AI Studio key — required when IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# fal.ai key — required when IMAGE_PROVIDER=fal.
FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/flux-2-pro

# OpenAI key — required when IMAGE_PROVIDER=openai. Get one at
# platform.openai.com/api-keys. Your OpenAI ORGANIZATION must separately
# complete "API Organization Verification" (Settings -> Organization) before
# GPT Image requests will succeed — this is a one-time account step, not
# something a key alone unlocks.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium # low | medium | high | auto — medium beat high in testing: faster and better-looking
# OPENAI_IMAGE_SIZE=1024x1024 # 1024x1024 | 1536x1024 | 1024x1536 | ... — overrides the automatic aspect-ratio pick

# OPTIONAL — force live research regeneration on every /api/topics request,
# bypassing the 24h cache. Leave unset/false in normal/production operation.
# (Per-request alternative during testing: GET /api/topics?fresh=true)
# DISABLE_RESEARCH_CACHE=true
